# --- Core ---
DATABASE_URL=sqlite:///./triage.db
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/triage
STORE_NAME=Our Store
TICKET_PREFIX=RBN
TICKET_TIMEZONE=Asia/Yangon
MAX_MESSAGE_LENGTH=2000
MAX_BODY_BYTES=20000

# --- Walk-in kiosk ---
KIOSK_RATE_LIMIT_PER_MINUTE=10

# --- AI triage ---
# Choose one: gemini, openai, claude. Only that provider's key is needed.
TRIAGE_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: pin an exact model instead of the provider's default, e.g.
# TRIAGE_MODEL=google:gemini-3.6-flash
TRIAGE_MODEL=
# Optional: backups tried in order if the main model is overloaded or down.
# Leave the line out to use the provider's defaults; set it empty for no fallback.
# Other providers are allowed; any without an API key are skipped.
# TRIAGE_FALLBACK_MODELS=google:gemini-3.6-flash,google:gemini-3.5-flash-lite
PYDANTIC_AI_NO_BANNER=1
TRIAGE_CONFIDENCE_THRESHOLD=0.7
TRIAGE_TIMEOUT_SECONDS=30

# --- Routing and replies ---
# hold_for_approval: every AI draft waits for you (recommended to start).
# auto_send_simple: simple, confident, low/medium-urgency drafts are sent automatically.
REPLY_POLICY=hold_for_approval

# --- Facebook Messenger ---
# App secret: Meta app dashboard > App settings > Basic
FB_APP_SECRET=
# Any random string you choose; enter the same one in the webhook setup
FB_VERIFY_TOKEN=
# Messenger settings > generate a token for your page
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_API_VERSION=v26.0
FB_REPLY_WINDOW_HOURS=24

# --- Admin ---
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
